    <main>
    <section class="hero">
        <div class="container">
            <h1>Authorized Electrolux Appliance Repair NYC</h1>
            <p>Same-Day Service • Factory-Trained Technicians • All NYC</p>
            <button class="btn" id="heroCallNow">Request Service Today</button>
