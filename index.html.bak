    <link rel="shortcut icon" href="https://electroluxappliancerepairnyc.com/favicon.png">
    <style>
        :root {
            --blue: #012169;
            --red: #e41e26;
            --gray: #f8f9fa;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            margin: 0;
            color: #333;
            background: #fff;
            line-height: 1.6;
            box-sizing: border-box;
            overscroll-behavior: none;
        }
        h1, h2, h3 {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            font-weight: 700;
            color: var(--blue);
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            box-sizing: border-box;
        }
        header {
            background: var(--blue);
            color: white;
            padding: 20px 0;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            box-sizing: border-box;
        }
        .logo-link {
            display: flex;
            align-items: center;
            text-decoration: none;
        }
        .logo-link:hover { opacity: 0.9; }
        .header-logo {
            height: 45px;
            width: auto;
        }
        .nav-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }
        .nav-right {
            display: flex;
            gap: 20px;
            align-items: center;
            flex-wrap: wrap;
        }
        .services-menu { position: relative; }
        .services-btn {
            color: white;
            font-weight: 600;
            cursor: pointer;
            padding: 12px 20px;
            border-radius: 6px;
            transition: all .3s;
            background: rgba(255, 255, 255, 0.1);
            white-space: nowrap;
            box-sizing: border-box;
        }
        .services-btn:hover { background: rgba(255, 255, 255, 0.2); }
        .nav-call-btn {
            background: var(--red);
            color: white;
            padding: 12px 28px;
            border-radius: 6px;
            font-weight: 700;
            text-decoration: none;
            font-size: 17px;
            transition: all .3s;
            cursor: pointer;
            box-sizing: border-box;
            border: none;
        }
        .nav-call-btn:hover {
            background: #c41b20;
            transform: translateY(-2px);
        }
        .services-dropdown {
            display: none;
            position: fixed;
            top: 80px;
            width: 420px;
            min-width: 360px;
            max-width: 95%;
            min-height: 100px;
            background: var(--blue);
            border-radius: 12px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
            padding: 32px 0;
            z-index: 1000;
            max-height: 80vh;
            overflow-y: auto;
            box-sizing: border-box;
            overflow-wrap: break-word;
            white-space: nowrap;
            overscroll-behavior: contain;
        }
        .services-menu.active .services-dropdown { display: block; }
        @media (hover: hover) and (pointer: fine) {
            .services-menu:hover .services-dropdown { display: block; }
        }
        #servicesMenu .services-dropdown { right: 20px; }
        .dropdown-close-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            background: rgba(255, 255, 255, 0.15);
            border: none;
            color: white;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            transition: all .3s;
            z-index: 10;
        }
        .dropdown-close-btn:hover {
            background: var(--red);
            transform: rotate(90deg);
        }
        @media (max-width: 768px) {
            .services-dropdown {
                width: 95%;
                max-width: 420px;
                min-width: 320px;
                right: auto;
                left: 50%;
                transform: translateX(-50%);
                top: 80px;
            }
            .nav-wrapper {
                flex-direction: column;
                padding: 15px 0;
            }
            .logo-link { margin-bottom: 10px; }
            .nav-right {
                width: 100%;
                justify-content: center;
                gap: 15px;
            }
        }
        @media (max-width: 480px) {
            .services-dropdown {
                width: 95%;
                max-width: 380px;
                min-width: 300px;
            }
        }
        .services-dropdown li {
            padding: 22px 36px;
            margin: 14px 0;
            color: #eee;
            font-size: 18px;
            line-height: 2.3;
            transition: all .3s;
            cursor: pointer;
            box-sizing: border-box;
        }
        .services-dropdown li:hover {
            background: var(--red);
            color: white;
            padding-left: 46px;
        }
        .services-dropdown a {
            color: #eee;
            text-decoration: none;
            display: block;
            width: 100%;
            height: 100%;
        }
        .services-dropdown li:hover a { color: white; }
        .submenu-toggle {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 700;
            background: rgba(255, 255, 255, 0.15);
            margin: 14px 20px;
            border-radius: 8px;
            padding: 22px 24px;
            cursor: pointer;
            box-sizing: border-box;
        }
        .submenu-toggle:after {
            content: "›";
            transition: transform .3s;
            font-size: 18px;
        }
        .submenu-toggle:hover:after { transform: rotate(90deg); }
        .additional-submenu,
        .service-areas-submenu {
            max-height: 0;
            overflow-y: auto;
            transition: max-height 0.8s ease;
            background: rgba(0, 0, 0, 0.2);
            margin: 0 20px 14px;
            border-radius: 8px;
            box-sizing: border-box;
            white-space: normal;
            -webkit-overflow-scrolling: touch;
        }
        .additional-submenu li,
        .service-areas-submenu li {
            padding: 20px 44px;
            color: #eee;
            font-size: 17px;
            line-height: 2.1;
            margin: 12px 0;
            transition: all .3s;
            box-sizing: border-box;
            cursor: pointer;
        }
        .additional-submenu li:hover,
        .additional-submenu li:active,
        .service-areas-submenu li:hover,
        .service-areas-submenu li:active {
            background: var(--red);
            color: white;
            padding-left: 54px;
        }
        .service-areas-submenu li a {
            color: #eee;
            text-decoration: none;
            display: block;
            width: 100%;
            height: 100%;
            transition: all .3s;
            cursor: pointer;
            pointer-events: auto;
        }
        .service-areas-submenu li:hover a,
        .service-areas-submenu li:active a { color: white; }
        .hero {
            position: relative;
            color: white;
            text-align: center;
            padding: 160px 20px 120px;
            margin-top: 80px;
            background: linear-gradient(rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0.78)), url('https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=1920&q=80') center center/cover no-repeat;
            background-attachment: scroll;
            min-height: 70vh;
            display: flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
        }
        .hero h1 {
            font-size: 52px;
            margin-bottom: 16px;
            text-shadow: 3px 3px 12px rgba(0, 0, 0, 0.9);
            line-height: 1.2;
            color: white;
        }
        .hero p {
            font-size: 24px;
            max-width: 900px;
            margin: 0 auto 35px;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);
        }
        .btn {
            background: var(--red);
            color: white;
            padding: 16px 40px;
            border-radius: 8px;
            font-weight: 700;
            text-decoration: none;
            display: inline-block;
            font-size: 20px;
            transition: all .3s;
            box-sizing: border-box;
            border: none;
            cursor: pointer;
        }
        .btn:hover {
            background: #c41b20;
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(228, 30, 38, 0.5);
        }
        @media (max-width: 768px) {
            .hero {
                padding: 160px 15px 90px;
                min-height: 55vh;
                background-position: center center;
                background-size: cover;
            }
            .hero h1 { font-size: 32px; line-height: 1.3; }
            .hero p { font-size: 18px; padding: 0 10px; }
            .btn { padding: 14px 30px; font-size: 18px; }
        }
        @media (max-width: 480px) {
            .hero { padding: 150px 15px 60px; min-height: 50vh; }
            .hero h1 { font-size: 26px; line-height: 1.3; }
            .hero p { font-size: 16px; }
            .btn { padding: 12px 24px; font-size: 16px; }
        }
        section { padding: 90px 0; box-sizing: border-box; }
        .alt { background: var(--gray); }
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            align-items: start;
        }
        .service {
            background: white;
            padding: 40px 35px;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            text-align: center;
            transition: all .4s ease;
            position: relative;
            cursor: pointer;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
        }
        .service-types {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .service-types > div[id^="expandable-content-"] { margin-top: auto; }
        .service:hover {
            transform: translateY(-12px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }
        .service-icon {
            font-size: 52px;
            margin-bottom: 20px;
            color: var(--blue);
            transition: color .3s;
        }
        .service:hover .service-icon { color: var(--red); }
        .service-image {
            width: 100%;
            height: 200px;
            background: transparent;
            border-radius: 10px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--blue);
            font-size: 14px;
            overflow: hidden;
            padding: 10px;
            box-sizing: border-box;
        }
        .service-image img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }
        .service-image span { opacity: 0.7; }
        .learn-more-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--blue) 0%, #004494 100%);
            color: white;
            padding: 15px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 15px;
            transition: background 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 48, 135, 0.3);
            width: 100%;
            min-height: 70px;
            box-sizing: border-box;
            text-align: center;
        }
        .learn-more-btn span {
            font-weight: 400;
            opacity: 0.85;
            font-size: 12px;
            margin-top: 4px;
        }
        .learn-more-btn:hover {
            background: linear-gradient(135deg, #0056b3 0%, #003d7a 100%);
            box-shadow: 0 5px 18px rgba(0, 48, 135, 0.4);
            color: white;
        }
        .learn-more-btn::after { display: none; }
        .service-types {
            margin-top: 20px;
            padding: 20px;
            background: rgba(0, 48, 135, 0.05);
            border-radius: 10px;
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            transition: max-height 0.5s ease, opacity 0.5s ease;
            box-sizing: border-box;
        }
        .service.active .service-types {
            max-height: 2000px;
            overflow: visible;
            opacity: 1;
        }
        .service-types h4 {
            margin: 0 0 15px;
            color: var(--blue);
            font-size: 18px;
            font-weight: 600;
        }
        .service-types ul { list-style: none; padding: 0; margin: 0; }
        .service-types li {
            padding: 12px 20px;
            margin: 6px 0;
            background: rgba(255, 255, 255, 0.8);
            border-radius: 8px;
            transition: background .3s, color .3s;
            color: #333;
            font-size: 15px;
            box-sizing: border-box;
        }
        .service-types li:hover,
        .service-types li:active {
            background: var(--red);
            color: white;
        }
        /* Service Areas Section Styles */
        #sa-service-areas {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: transparent;
            border: 2px solid #808080;
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, .2);
            margin: 0 auto 3rem;
            padding: 20px;
            position: relative;
            box-sizing: border-box;
        }
        #sa-service-areas h2 {
            font-size: 34px;
            text-align: center;
            color: inherit;
            margin-bottom: 5px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, .3);
            transition: transform .3s, color .3s;
        }
        #sa-service-areas p {
            font-size: 16px;
            text-align: center;
            margin-bottom: 20px;
            text-shadow: 0 1px 3px rgba(0, 0, 0, .2);
        }
        .sa-dropdown-container {
            text-align: center;
            margin-bottom: 20px;
        }
        .sa-dropdown-button {
            padding: 14px 32px;
            border: none;
            background: linear-gradient(45deg, #012169, #0052cc);
            color: #fff;
            font-weight: 600;
            font-size: 18px;
            border-radius: 10px;
            cursor: pointer;
            transition: all .3s;
            box-shadow: 0 4px 15px rgba(0, 48, 135, .4);
            box-sizing: border-box;
        }
        .sa-dropdown-button:hover {
            background: linear-gradient(45deg, #002266, #003f99);
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 48, 135, .6);
        }
        .sa-dropdown-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height .5s;
            background: transparent;
            box-sizing: border-box;
        }
        .sa-slider-container {
            display: flex;
            overflow: hidden;
            scroll-snap-type: x mandatory;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
        }
        .sa-slide {
            flex: 0 0 100%;
            scroll-snap-align: start;
            padding: 20px;
            box-sizing: border-box;
        }
        .sa-slide h2 {
            font-size: 24px;
            text-align: center;
            color: var(--blue);
            margin-bottom: 15px;
        }
        .sa-slide ul {
            background: rgba(255, 255, 255, .95);
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, .1);
            transition: transform .3s;
            box-sizing: border-box;
            list-style: none;
            margin: 0;
            column-gap: 30px;
            columns: 3;
        }
        .sa-slide ul li {
            padding: 12px 15px;
            margin: 8px 0;
            border-radius: 10px;
            background: rgba(240, 244, 255, .9);
            transition: all .3s;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0, 0, 0, .08);
            box-sizing: border-box;
            break-inside: avoid;
        }
        .sa-slide ul li:hover {
            background: #d4e4ff;
            transform: scale(1.03);
            box-shadow: 0 4px 12px rgba(0, 0, 0, .15);
        }
        .sa-slide ul li h3 {
            margin: 0;
            font-size: 17px;
            color: #1e3c72;
            font-weight: 600;
        }
        .sa-nav-buttons {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
        }
        .sa-nav-btn {
            padding: 12px 25px;
            border: none;
            background: linear-gradient(45deg, #012169, #0052cc);
            color: #fff;
            font-weight: 600;
            font-size: 16px;
            border-radius: 8px;
            cursor: pointer;
            transition: all .3s;
            box-shadow: 0 3px 10px rgba(0, 48, 135, .3);
        }
        .sa-nav-btn:hover {
            background: linear-gradient(45deg, #002266, #003f99);
            transform: translateY(-2px);
        }
        .sa-nav-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }
        .sa-borough-tabs {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }
        .sa-borough-tab {
            padding: 10px 20px;
            border: 2px solid var(--blue);
            background: transparent;
            color: var(--blue);
            font-weight: 600;
            font-size: 14px;
            border-radius: 25px;
            cursor: pointer;
            transition: all .3s;
        }
        .sa-borough-tab:hover,
        .sa-borough-tab.active {
            background: var(--blue);
            color: white;
        }
        @media (max-width: 768px) {
            .sa-slide ul { columns: 2; }
            .sa-borough-tab { padding: 8px 15px; font-size: 13px; }
        }
        @media (max-width: 480px) {
            .sa-slide ul { columns: 1; }
        }
        /* Contact Form Section Styles */
        #cf-schedule-container {
            background: transparent;
            border: 2px solid #808080;
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, .2);
            padding: 20px;
            margin: 3rem auto 0;
            max-width: 1200px;
            box-sizing: border-box;
        }
        .cf-schedule-text {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            font-size: 1.5rem;
            color: #2A2A2A;
            font-weight: 600;
            text-align: center;
            margin-bottom: 15px;
        }
        .cf-book-button {
            display: block;
            padding: 12px 20px;
            background: linear-gradient(45deg, #012169, #00205B);
            color: #fff;
            font-weight: 600;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            margin: 10px auto;
            width: 100%;
            max-width: 220px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .3s;
            box-sizing: border-box;
        }
        .cf-book-button:hover {
            background: linear-gradient(45deg, #00205B, #001A45);
            transform: translateY(-3px);
        }
        .form-call-now {
            display: block;
            padding: 12px 28px;
            background: var(--red);
            color: white;
            font-weight: 700;
            border-radius: 6px;
            font-size: 17px;
            cursor: pointer;
            margin: 15px auto 0;
            width: 100%;
            max-width: 220px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .3s;
            box-sizing: border-box;
            border: none;
        }
        .form-call-now:hover {
            background: #c41b20;
            transform: translateY(-3px);
        }
        .cf-contact-form-section {
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            transition: all .6s ease;
            padding: 0;
            background: linear-gradient(135deg, #012169 0%, #00205B 50%, #001A45 100%);
            border-radius: 12px;
            margin-top: 15px;
            box-sizing: border-box;
        }
        .cf-contact-form-section.active {
            max-height: 1600px;
            opacity: 1;
            padding: 20px;
        }
        .expect-text {
            font-size: .95rem;
            color: #fff;
            text-align: center;
            margin-bottom: 15px;
        }
        .cf-contact-form {
            background: rgba(255, 255, 255, .95);
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            box-sizing: border-box;
        }
        .cf-form-group {
            display: flex;
            flex-direction: column;
        }
        .cf-form-group label {
            font-size: 1rem;
            font-weight: 600;
            color: #000;
            margin-bottom: 5px;
        }
        .cf-form-group input,
        .cf-form-group textarea {
            padding: 12px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 8px;
            background: #fff;
            box-sizing: border-box;
        }
        .cf-form-group textarea {
            resize: vertical;
            min-height: 100px;
        }
        .cf-form-button {
            background: linear-gradient(45deg, #012169, #00205B);
            color: #fff;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            width: 220px;
            height: 60px;
            margin: 20px auto 0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .3s;
            box-sizing: border-box;
        }
        .cf-form-button:hover {
            background: linear-gradient(45deg, #00205B, #001A45);
            transform: translateY(-3px);
        }
        .cf-success-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 2000;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
        }
        .cf-success-modal.active {
            display: flex;
        }
        .cf-success-content {
            background: white;
            padding: 40px 30px;
            border-radius: 12px;
            text-align: center;
            max-width: 90%;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            box-sizing: border-box;
        }
        .cf-success-content p {
            font-size: 20px;
            font-weight: 600;
            color: #012169;
            margin: 0 0 25px;
            line-height: 1.6;
        }
        .cf-close-modal {
            background: var(--red);
            color: white;
            border: none;
            padding: 12px 32px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            box-sizing: border-box;
        }
        .cf-modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 1999;
        }
        .cf-modal-overlay.active {
            display: block;
        }
        /* Footer Styles */
        footer {
            background: #1a1a1a;
            color: #b0b0b0;
            padding: 0;
            box-sizing: border-box;
        }
        .footer-main {
            background: #1a1a1a;
            padding: 60px 0 40px;
            border-bottom: 1px solid #333;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1.5fr;
            gap: 50px;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        .footer-column h3 {
            color: #fff;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 20px;
        }
        .footer-column p { margin: 8px 0; line-height: 1.8; font-size: 14px; }
        .footer-column ul { list-style: none; padding: 0; margin: 0; }
        .footer-column ul li { margin: 12px 0; }
        .footer-column ul li a {
            color: #b0b0b0;
            text-decoration: none;
            font-size: 14px;
            transition: color .3s;
            display: inline-block;
        }
        .footer-column ul li a:hover { color: var(--red); padding-left: 5px; }
        .footer-brand { display: flex; flex-direction: column; }
        .footer-brand h2 {
            color: #fff;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 15px;
        }
        .footer-hours {
            background: rgba(0, 48, 135, 0.1);
            padding: 15px;
            border-radius: 8px;
            margin-top: 20px;
            border-left: 4px solid var(--blue);
        }
        .footer-hours p { margin: 5px 0; font-size: 14px; }
        .footer-hours strong { color: #fff; }
        .footer-bottom { background: #0d0d0d; padding: 25px 0; }
        .footer-bottom-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        .footer-bottom p {
            margin: 8px 0;
            font-size: 13px;
            color: #888;
            text-align: center;
        }
        .footer-bottom-links {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 0 0 20px 0;
            flex-wrap: wrap;
            gap: 15px;
            padding: 20px 0;
            border-bottom: 1px solid #222;
        }
        .footer-bottom-links a {
            color: #b0b0b0;
            text-decoration: none;
            font-size: 14px;
            transition: color .3s;
            white-space: nowrap;
        }
        .footer-bottom-links a:hover { color: var(--blue); }
        @media (max-width: 992px) {
            .footer-grid { grid-template-columns: 1fr 1fr; gap: 40px; }
            .footer-bottom-links { justify-content: center; gap: 20px 30px; }
            .sa-slide ul { columns: 2; }
        }
        @media (max-width: 768px) {
            .footer-grid { grid-template-columns: 1fr; gap: 35px; }
            .footer-main { padding: 40px 0 30px; }
            .footer-column { text-align: center; }
            .footer-brand { align-items: center; }
            .footer-bottom-links { gap: 15px 25px; }
            .sa-slide ul { columns: 1; }
        }
        @media (max-width: 480px) {
            .footer-bottom-links { flex-direction: column; gap: 12px; padding: 15px 0; }
            .footer-bottom-links a { font-size: 13px; }
        }
    </style>
</head>
