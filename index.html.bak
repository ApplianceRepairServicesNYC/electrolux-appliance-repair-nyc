    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const servicesMenu = document.getElementById('servicesMenu');
            const servicesToggle = document.getElementById('servicesToggle');
            const dropdownCloseBtn = document.getElementById('dropdownCloseBtn');
            const additionalToggle = document.getElementById('additionalToggle');
            const additionalSubmenu = document.getElementById('additionalSubmenu');
            const serviceAreasToggle = document.getElementById('serviceAreasToggle');
            const serviceAreasSubmenu = document.getElementById('serviceAreasSubmenu');
            
            function closeDropdown() {
                if (servicesMenu) servicesMenu.classList.remove('active');
                if (additionalSubmenu) additionalSubmenu.style.maxHeight = '0';
                if (serviceAreasSubmenu) serviceAreasSubmenu.style.maxHeight = '0';
            }
            
            if (servicesToggle) {
                servicesToggle.addEventListener('click', function(e) {
                    e.stopPropagation();
                    servicesMenu.classList.toggle('active');
                });
            }
            
            if (dropdownCloseBtn) {
                dropdownCloseBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    closeDropdown();
                });
            }
            
            if (additionalToggle && additionalSubmenu) {
                additionalToggle.addEventListener('click', function(e) {
                    e.stopPropagation();
                    if (additionalSubmenu.style.maxHeight && additionalSubmenu.style.maxHeight !== '0px') {
                        additionalSubmenu.style.maxHeight = '0';
                    } else {
                        additionalSubmenu.style.maxHeight = additionalSubmenu.scrollHeight + 'px';
                    }
                });
            }
            
            if (serviceAreasToggle && serviceAreasSubmenu) {
                serviceAreasToggle.addEventListener('click', function(e) {
                    e.stopPropagation();
                    if (serviceAreasSubmenu.style.maxHeight && serviceAreasSubmenu.style.maxHeight !== '0px') {
                        serviceAreasSubmenu.style.maxHeight = '0';
                    } else {
                        serviceAreasSubmenu.style.maxHeight = serviceAreasSubmenu.scrollHeight + 'px';
                    }
                });
            }
            
            document.addEventListener('click', closeDropdown);
            
            // Service Areas section toggle and slider
            const saToggle = document.getElementById('saToggleBtn');
            const saContent = document.getElementById('saDropdownContent');
            const saSlider = document.getElementById('saSliderContainer');
            const saTabs = document.querySelectorAll('.sa-borough-tab');
            const saPrevBtn = document.getElementById('saPrevBtn');
            const saNextBtn = document.getElementById('saNextBtn');
            let saCurrentSlide = 0;
            const saTotalSlides = 4;
            
            function saUpdateSlider() {
                if (saSlider) {
                    const slideWidth = saSlider.clientWidth;
                    saSlider.scrollTo({ left: saCurrentSlide * slideWidth, behavior: 'smooth' });
                }
                saTabs.forEach((tab, index) => {
                    tab.classList.toggle('active', index === saCurrentSlide);
                });
                if (saPrevBtn) saPrevBtn.disabled = saCurrentSlide === 0;
                if (saNextBtn) saNextBtn.disabled = saCurrentSlide === saTotalSlides - 1;
            }
            
            if (saToggle && saContent) {
                saToggle.addEventListener('click', function() {
                    if (saContent.style.maxHeight && saContent.style.maxHeight !== '0px') {
                        saContent.style.maxHeight = '0';
                    } else {
                        saContent.style.maxHeight = saContent.scrollHeight + 'px';
                        setTimeout(saUpdateSlider, 100);
                    }
                });
            }
            
            saTabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    saCurrentSlide = parseInt(this.dataset.borough);
                    saUpdateSlider();
                    if (saContent) saContent.style.maxHeight = saContent.scrollHeight + 'px';
                });
            });
            
            if (saPrevBtn) {
                saPrevBtn.addEventListener('click', function() {
                    if (saCurrentSlide > 0) {
                        saCurrentSlide--;
                        saUpdateSlider();
                    }
                });
            }
            
            if (saNextBtn) {
                saNextBtn.addEventListener('click', function() {
                    if (saCurrentSlide < saTotalSlides - 1) {
                        saCurrentSlide++;
                        saUpdateSlider();
                    }
                });
            }
            
            const services = document.querySelectorAll('.service');
            services.forEach(function(service) {
                service.addEventListener('click', function(e) {
                    if (e.target.tagName === 'BUTTON' || 
                        e.target.closest('button') || 
                        e.target.tagName === 'A' || 
                        e.target.closest('a') || 
                        e.target.tagName === 'LI' || 
                        e.target.closest('.service-types ul') || 
                        e.target.closest('.learn-more-btn')) {
                        return;
                    }
                    this.classList.toggle('active');
                });
            });
            
            // Contact form toggle
            const cfBookButton = document.getElementById('cfBookButton');
            if (cfBookButton) {
                cfBookButton.addEventListener('click', function() {
                    document.getElementById('cfContactFormSection').classList.toggle('active');
                });
            }
            
            function setupCallButton(btn) {
                if (btn) {
                    btn.addEventListener('click', function() {
                        if (this.dataset.revealed) return;
                        const digits = [7, 1, 8, 2, 5, 5, 5, 0, 4, 9];
                        const num = digits.join('');
                        const formatted = '+1 (' + num.slice(0,3) + ') ' + num.slice(3,6) + '-' + num.slice(6);
                        this.innerHTML = formatted;
                        this.dataset.revealed = 'true';
                        this.onclick = function() {
                            window.location.href = 'tel:+1' + num;
                        };
                    });
                }
            }
            
            setupCallButton(document.getElementById('navCallNow'));
            setupCallButton(document.getElementById('formCallNow'));
            setupCallButton(document.getElementById('heroCallNow'));
            
            // Contact form submission
            const cfContactForm = document.getElementById('cfContactForm');
            if (cfContactForm) {
                cfContactForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const email = this.user_email.value.trim();
                    // Copy email to hidden fields for template compatibility
                    document.getElementById('cfReplyTo').value = email;
                    document.getElementById('cfEmailHidden').value = email;
                    document.getElementById('cfFromEmail').value = email;
                    document.getElementById('cfCustomerEmail').value = email;
                    document.getElementById('cfApplianceType').value = this.subject.value;
                    if (typeof emailjs !== 'undefined') {
                        emailjs.sendForm('service_emxksio', 'template_tmexlql', this)
                            .then(function() {
                                cfContactForm.reset();
                                document.getElementById('cfContactFormSection').classList.remove('active');
                                document.getElementById('successMessage').innerHTML = '<strong>Thank you!</strong><br><br>Your request has been sent.<br><br>We will contact you at<br><strong>' + email + '</strong><br>within the next 30 minutes.';
                                document.getElementById('cfSuccessModal').classList.add('active');
                                document.getElementById('cfModalOverlay').classList.add('active');
                            })
                            .catch(function() {
                                alert('Failed to send. Please try again or call us.');
                            });
                    } else {
                        // Fallback if emailjs not loaded
                        cfContactForm.reset();
                        document.getElementById('cfContactFormSection').classList.remove('active');
                        document.getElementById('successMessage').innerHTML = '<strong>Thank you!</strong><br><br>Your request has been sent.<br><br>We will contact you at<br><strong>' + email + '</strong><br>within the next 30 minutes.';
                        document.getElementById('cfSuccessModal').classList.add('active');
                        document.getElementById('cfModalOverlay').classList.add('active');
                    }
                });
            }
            
            // Modal close
            const cfCloseModal = document.getElementById('cfCloseModal');
            if (cfCloseModal) {
                cfCloseModal.onclick = function() {
                    document.getElementById('cfSuccessModal').classList.remove('active');
                    document.getElementById('cfModalOverlay').classList.remove('active');
                };
            }
            
            const cfModalOverlay = document.getElementById('cfModalOverlay');
            if (cfModalOverlay) {
                cfModalOverlay.onclick = function() {
                    if (cfCloseModal) cfCloseModal.click();
                };
            }
        });
        
        function toggleService(btn) {
            event.preventDefault();
            event.stopPropagation();
            
            const serviceCard = btn.closest('.service');
            const isActive = serviceCard.classList.contains('active');
            
            document.querySelectorAll('.service').forEach(function(card) {
                card.classList.remove('active');
                const cardBtn = card.querySelector('.learn-more-btn');
                if (cardBtn) {
                    const span = cardBtn.querySelector('span');
                    if (span) span.textContent = 'Learn More';
                }
            });
            
            if (!isActive) {
                serviceCard.classList.add('active');
                const span = btn.querySelector('span');
                if (span) span.textContent = 'Show Less';
            }
        }
        
        function toggleExpand(id) {
            event.stopPropagation();
            var text = document.getElementById('expandable-text-' + id);
            var btn = document.getElementById('expandable-btn-' + id);
            var fade = document.getElementById('expandable-fade-' + id);
            var isCollapsed = !text.classList.contains('expanded');
            if (isCollapsed) {
                text.style.maxHeight = '200px';
                text.style.overflowY = 'auto';
                text.style.paddingRight = '10px';
                text.classList.add('expanded');
                btn.innerHTML = '− Show Less';
                btn.setAttribute('aria-expanded', 'true');
                if (fade) fade.style.display = 'none';
            } else {
                var originalHeight = text.getAttribute('data-collapsed-height') || '80px';
                text.style.maxHeight = originalHeight;
                text.style.overflowY = 'hidden';
                text.style.paddingRight = '0';
                text.classList.remove('expanded');
                btn.innerHTML = '+ Show More';
                btn.setAttribute('aria-expanded', 'false');
                if (fade) fade.style.display = 'block';
            }
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('[id^="expandable-text-"]').forEach(function(el) {
                var height = el.style.maxHeight || '80px';
                el.setAttribute('data-collapsed-height', height);
            });
        });
    </script>
    <style>
        [id^="expandable-text-"].expanded::-webkit-scrollbar { width: 6px; }
        [id^="expandable-text-"].expanded::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 3px; }
        [id^="expandable-text-"].expanded::-webkit-scrollbar-thumb { background: var(--blue); border-radius: 3px; }
        [id^="expandable-text-"].expanded::-webkit-scrollbar-thumb:hover { background: var(--red); }
        [id^="expandable-text-"].expanded { scrollbar-width: thin; scrollbar-color: var(--blue) #f1f1f1; }
    </style>
