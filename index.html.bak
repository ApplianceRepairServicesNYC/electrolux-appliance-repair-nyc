    <!-- Internal Links Section -->
    <section style="padding: 40px 20px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
        <div class="container" style="max-width: 900px; margin: 0 auto;">
            <div style="background: white; padding: 30px 35px; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.08);">
                <h3 style="color: var(--blue); margin-bottom: 20px; font-size: 20px; border-bottom: 2px solid var(--blue); padding-bottom: 10px;">Electrolux Appliance Resources</h3>
                <p style="line-height: 1.8; color: #444; margin-bottom: 15px;">
                    Before scheduling service, check our Electrolux appliance troubleshooting guide for diagnostic steps, error code explanations, and DIY fixes for common issues across all Electrolux appliances.
                </p>
                <p style="line-height: 1.8; color: #444; margin-bottom: 15px;">
                    Refrigerator not cooling? Electrolux's compressors can fail over time. Our compressor replacement service includes sealed system repair with warranty coverage for New York City homeowners.
                </p>
                <p style="line-height: 1.8; color: #555; margin-bottom: 0; padding-top: 15px; border-top: 1px solid #eee;">
                    <strong>Serving all New York City boroughs</strong> including 
                    Manhattan, Brooklyn, Queens, and The Bronx.
                </p>
            </div>
        </div>
    </section>

